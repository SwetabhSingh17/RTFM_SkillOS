# AI Services (Local LLM via LM Studio / Ollama)
# LM Studio default port: 1234, Ollama default port: 11434
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
LLM_MODEL=local-model
LLM_MAX_TOKENS=4096

# Database
DATABASE_URL=postgresql://localhost:5432/rtfm_skillos

# Session Secret
SESSION_SECRET=rtfm_skillos-secret-change-in-production

# Server
PORT=5000

# iGOT Karmayogi API (for future integration)
IGOT_API_BASE_URL=https://api.igotkarmayogi.gov.in
IGOT_API_KEY=
IGOT_WEBHOOK_SECRET=
IGOT_SYNC_INTERVAL_HOURS=24

# File Storage
UPLOAD_MAX_SIZE_MB=50
UPLOAD_STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# S3 (configure for production scalability)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# NSSTA TPAC (optional)
NSSTA_API_URL=
NSSTA_API_KEY=
